extends layout

block content
  fieldset
    legend Editar Donante
    p
      a(href="/vistas/donantes") &larr; Volver al listado
      | &nbsp;|&nbsp;
      a(href=`/vistas/donantes/${donante.idDonante}`) Ver detalle

    p
      strong ID Donante:
      = donante.idDonante
      |  (no editable)

    form(action=`/vistas/donantes/${donante.idDonante}/editar` method="POST")
      div
        label(for="nombre") Nombre
        input(type="text" name="nombre" id="nombre" value=donante.nombre required)

      div
        label(for="apellido") Apellido
        input(type="text" name="apellido" id="apellido" value=donante.apellido required)

      div
        label(for="dni") DNI
        input(type="text" name="dni" id="dni" value=donante.dni required)

      div
        label(for="telefono") Teléfono
        input(type="text" name="telefono" id="telefono" value=donante.telefono required)

      div
        label(for="email") Correo Electrónico
        input(type="email" name="email" id="email" value=donante.email required)

      div
        label(for="monto") Monto ($)
        input(type="number" step="0.01" name="monto" id="monto" value=donante.monto required)

      div
        label(for="fecha") Fecha (YYYY-MM-DD)
        input(type="date" name="fecha" id="fecha" value=donante.fecha.toISOString().slice(0, 10) required)

      .form-actions
        a.btn-secundario(href="/vistas/donantes") Cancelar
        button(type="submit") Guardar Cambios
