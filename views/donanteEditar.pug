
extends layout

block content
  article.formulario-card
    h3 Editar Donante

    form(action=`/vistas/donantes/${donante._id}/editar` method="POST")
      div
        label(for="nombre") Nombre
        input(type="text" name="nombre" id="nombre" value=donante.nombre required)

      div
        label(for="apellido") Apellido
        input(type="text" name="apellido" id="apellido" value=donante.apellido required)

      div
        label(for="dni") DNI
        input(type="text" name="dni" id="dni" value=donante.dni required pattern="[0-9]{7,8}" minlength="7" maxlength="8" inputmode="numeric")

      div
        label(for="telefono") Teléfono
        input(type="text" name="telefono" id="telefono" value=donante.telefono required)

      div
        label(for="email") Correo Electrónico
        input(type="email" name="email" id="email" value=donante.email required)

      .form-actions
        a.btn-secundario(href="/vistas/donantes") Cancelar
        button(type="submit") Guardar Cambios
