extends layout

block content
  article.formulario-card
    h3 Detalle de la Donación

    table.tabla-detalle
      tr
        th Monto
        td.num $ #{donacion.monto}
      tr
        th CBU
        td= donacion.cbu
      tr
        th Fecha
        td= donacion.fecha.toISOString().slice(0, 10)
      tr
        th Proyecto
        td= proyecto ? (proyecto.nombre || proyecto.nomProyecto) : "-"
      tr
        th Donante
        td= donante ? `${donante.nombre} ${donante.apellido}` : "-"
      tr
        th Organización
        td= organizacion ? organizacion.nombre : "-"

    p.acciones-detalle
      if currentUser && currentUser.role === 'admin'
        a.btn-secundario(href=`/vistas/donaciones/${donacion._id}/editar`) Editar
        a.btn-peligro(href=`/vistas/donaciones/${donacion._id}/eliminar`) Eliminar
      a.btn-secundario(href="/vistas/donaciones") Volver al listado
