extends layout

block content
  div(class="max-w-2xl mx-auto")
    div(class="mb-6")
      a(href="/vistas/proyectos" class="text-sm font-medium text-emerald-600 hover:text-emerald-700") &larr; Volver al listado de proyectos

    if proyecto
      div(class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8")
        div(class="flex justify-between items-center mb-4")
          span(class="text-xs font-semibold uppercase tracking-wider bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full") Proyecto ID ##{proyecto.id}
        h2(class="text-3xl font-bold text-slate-900 mb-4")= proyecto.nombre
        div(class="border-t border-slate-100 pt-4")
          h3(class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-2") Descripción
          p(class="text-slate-700 text-base leading-relaxed")= proyecto.descripcion
    else
      div(class="bg-white p-8 rounded-xl border border-slate-200 text-center text-slate-500")
        p El proyecto solicitado no fue encontrado.
