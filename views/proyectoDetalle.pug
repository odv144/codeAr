extends layout

block content
  fieldset
    legend Detalle del Proyecto
    p
      a(href="/vistas/proyectos") &larr; Volver al listado
    
    if proyecto
      table(border="1" cellpadding="5" cellspacing="0")
        tr
          th ID:
          td= proyecto.idProyecto
        tr
          th ID Organización:
          td= proyecto.idOrganizacion
        tr
          th Nombre:
          td= proyecto.nomProyecto
        tr
          th Descripción:
          td= proyecto.descripcion || "-"
        tr
          th Saldo actual:
          td
            if proyecto.saldo && proyecto.saldo.length > 0
              | $ #{proyecto.saldo[proyecto.saldo.length - 1].monto}
            else
              | -

      p(style="margin-top: 15px;")
        a(href=`/vistas/proyectos/${proyecto.idProyecto}/editar`) Editar
        | &nbsp;|&nbsp;
        a(href=`/vistas/proyectos/${proyecto.idProyecto}/eliminar`) Eliminar
        | &nbsp;|&nbsp;
        a(href="/vistas/proyectos") Volver al listado
    else
      p Proyecto no encontrado.
