extends layout

block content
  fieldset
    legend Detalle del Proyecto

    if proyecto
      table.tabla-detalle
        tr
          th ID
          td.num= proyecto._id
        tr
          th Organización
          td= organizacion ? `${organizacion.nombre} (#${proyecto.idOrganizacion})` : `(#${proyecto.idOrganizacion})`
        tr
          th Nombre
          td= proyecto.nomProyecto
        tr
          th Descripción
          td= proyecto.descripcion || "-"
        tr
          th Saldo actual
          td.num
            if proyecto.saldo && proyecto.saldo.length > 0
              | $ #{proyecto.saldo[proyecto.saldo.length - 1].monto}
            else
              | -

      p.acciones-detalle
        if currentUser && currentUser.role === 'admin'
          a.btn-secundario(href=`/vistas/proyectos/${proyecto._id}/editar`) Editar
          a.btn-peligro(href=`/vistas/proyectos/${proyecto._id}/eliminar`) Eliminar
        a.btn-secundario(href="/vistas/proyectos") Volver al listado
    else
      p Proyecto no encontrado.
