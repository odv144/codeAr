extends layout

block content
  fieldset
    legend Detalle del Proyecto
    p
      a(href="/vistas/proyectos") &larr; Volver al listado

    if proyecto
      table
        tr
          th.num ID
          td.num= proyecto.idProyecto
        tr
          th.num ID Organización
          td.num= proyecto.idOrganizacion
        tr
          th Nombre
          td= proyecto.nomProyecto
        tr
          th Descripción
          td= proyecto.descripcion || "-"
        tr
          th.num Saldo actual
          td.num
            if proyecto.saldo && proyecto.saldo.length > 0
              | $ #{proyecto.saldo[proyecto.saldo.length - 1].monto}
            else
              | -

      p.acciones-detalle
        if currentUser && currentUser.role === 'admin'
          a.btn-secundario(href=`/vistas/proyectos/${proyecto.idProyecto}/editar`) Editar
          a.btn-peligro(href=`/vistas/proyectos/${proyecto.idProyecto}/eliminar`) Eliminar
        a(href="/vistas/proyectos") Volver al listado
    else
      p Proyecto no encontrado.
