extends layout

block content
  fieldset
    legend Detalle del Proyecto

    if proyecto
      - const dadaDeBaja = proyecto.activa === false
      table.tabla-detalle
        tr
          th Organización
          td= organizacion ? organizacion.nombre : "-"
        tr
          th Nombre
          td= proyecto.nomProyecto
        tr
          th Descripción
          td= proyecto.descripcion || "-"
        tr
          th Saldo actual
          td.num= moneda(proyecto.saldoActual)
        if dadaDeBaja
          tr
            th Estado
            td
              span.estado-baja Dada de baja
              if proyecto.fechaBaja
                |  el #{new Date(proyecto.fechaBaja).toLocaleDateString('es-AR')}

      if aviso
        p.aviso-bloqueo= aviso

      h4 Movimientos del proyecto
      if movimientos && movimientos.length > 0
        table
          thead
            tr
              th FECHA
              th TIPO
              th CONCEPTO
              th.num MONTO
          tbody
            each mov in movimientos
              tr
                td= new Date(mov.fecha).toLocaleDateString('es-AR', { timeZone: 'UTC' })
                td
                  if mov.tipo === 'donacion'
                    span.badge-donacion Donación
                  else
                    span.badge-gasto Gasto
                td= mov.concepto
                td.num(class=(mov.tipo === 'gasto' ? 'estado-error' : 'estado-ok'))= monedaMovimiento(mov)
      else
        p No hay movimientos registrados para este proyecto.

      p.acciones-detalle
        if currentUser && currentUser.role === 'admin'
          if dadaDeBaja
            a.btn-primario(href=`/vistas/proyectos/${proyecto._id}/reactivar`) Reactivar
          else
            a.btn-secundario(href=`/vistas/proyectos/${proyecto._id}/editar`) Editar
            a.btn-peligro(href=`/vistas/proyectos/${proyecto._id}/eliminar`) Dar de baja
        a.btn-secundario(href="/vistas/proyectos") Volver al listado
    else
      p Proyecto no encontrado.
