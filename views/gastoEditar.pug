extends layout

block content
  article.formulario-card
    h3 Editar Gasto

    form(action=`/vistas/gastos/${gasto._id}/editar` method="POST")
      div
        label(for="idProyecto") Proyecto
        select(name="idProyecto" id="idProyecto" required)
          option(value="") Seleccioná un proyecto...
          each proyecto in proyectos
            option(value=proyecto._id selected=(String(proyecto._id) === String(gasto.idProyecto)))= proyecto.nomProyecto

      div
        label(for="descripcion") Descripción
        textarea(name="descripcion" id="descripcion" rows="4" required)= gasto.descripcion

      div
        label(for="monto") Monto ($)
        input(type="number" step="0.01" name="monto" id="monto" value=gasto.monto required)

      div
        label(for="fecha") Fecha (YYYY-MM-DD)
        input(type="date" name="fecha" id="fecha" value=gasto.fecha.toISOString().slice(0, 10) required)

      .form-actions
        a.btn-secundario(href="/vistas/gastos") Cancelar
        button(type="submit") Guardar Cambios
