extends layout

block content
  fieldset
    legend Organizaciones Sociales Aliadas
    p
      a(href="/vistas") &larr; Volver al inicio
      if currentUser && currentUser.role === 'admin'
        | &nbsp;|&nbsp;
        a(href="/vistas/organizaciones/nuevo") + Nueva Organización
    
    if organizaciones && organizaciones.length > 0
      table
        thead
          tr
            th.num ID
            th Nombre
            th Tipo
            th.num CUIL
            th.num Teléfono
            th Email
            th Responsable
            th Acciones
        tbody
          each org in organizaciones
            tr
              td.num= org.idOrganizacion
              td= org.nombre
              td= org.tipo
              td.num= org.cuil
              td.num= org.telefono
              td= org.mail
              td= org.responsable
              td.acciones
                a(href=`/vistas/organizaciones/${org.idOrganizacion}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/organizaciones/${org.idOrganizacion}/editar`) Editar
                  a(href=`/vistas/organizaciones/${org.idOrganizacion}/eliminar`) Dar de baja
    else
      p No hay organizaciones registradas.
