extends layout

block content
  article.formulario-card
    h3 Registrar Nueva Donación

    form(action="/vistas/donaciones" method="POST")
      div
        label(for="idProyecto") Proyecto
        select(name="idProyecto" id="idProyecto" required)
          option(value="") Seleccioná un proyecto...
          each org in organizaciones
            - const propios = proyectos.filter(p => String(p.idOrganizacion) === String(org._id))
            if propios.length
              optgroup(label=org.nombre)
                each proyecto in propios
                  option(value=proyecto._id)= proyecto.nomProyecto

      div
        label(for="idDonante") Donante
        select(name="idDonante" id="idDonante" required)
          option(value="") Seleccioná un donante...
          each donante in donantes
            option(
              value=donante._id
              selected=String(donante._id) === String(donanteSeleccionado || "")
            )= `${donante.nombre} ${donante.apellido}`

      div
        label(for="monto") Monto ($)
        input(type="number" step="0.01" min="1" name="monto" id="monto" required)

      div
        label(for="cbu") CBU / Cuenta
        input(type="text" name="cbu" id="cbu" required pattern="[0-9]{22}" minlength="22" maxlength="22" inputmode="numeric" title="El CBU debe contener exactamente 22 dígitos numéricos")

      div
        label(for="fecha") Fecha (YYYY-MM-DD)
        input(type="date" name="fecha" id="fecha" required)

      .form-actions
        button.btn-secundario(type="reset") Limpiar
        a.btn-secundario(href="/vistas/donaciones") Cancelar
        button(type="submit") Guardar Donación


