extends layout

block content
  fieldset
    legend Registrar Nueva Donación
    p
      a(href="/vistas/donaciones") &larr; Volver al listado de donaciones

    form(action="/vistas/donaciones" method="POST")
      div
        label(for="monto") Monto ($)
        input(type="number" step="0.01" name="monto" id="monto" required)

      div
        label(for="cbu") CBU / Cuenta
        input(type="text" name="cbu" id="cbu" required)

      div
        label(for="fecha") Fecha (YYYY-MM-DD)
        input(type="date" name="fecha" id="fecha" required)

      div
        label(for="idProyecto") ID Proyecto
        input(type="number" name="idProyecto" id="idProyecto" required)

      div
        label(for="idDonante") ID Donante
        input(type="number" name="idDonante" id="idDonante" required)

      div
        label(for="idOrganizacion") ID Organización
        input(type="number" name="idOrganizacion" id="idOrganizacion" required)

      .form-actions
        button.btn-secundario(type="reset") Limpiar
        button(type="submit") Guardar Donación
