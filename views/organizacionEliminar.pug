extends layout

block content
  fieldset
    legend Dar de Baja Organización

    p
      | ¿Confirma dar de baja la siguiente organización?
      strong  La organización será dada de baja y dejará de estar activa. El registro y su historial no serán eliminados.
      |  Es una baja lógica: se conservan los proyectos y donaciones asociados.

    table.tabla-detalle
      tr
        th ID
        td.num= organizacion._id
      tr
        th Nombre
        td= organizacion.nombre
      tr
        th Tipo
        td= organizacion.tipo
      tr
        th CUIL
        td.num= organizacion.cuil
      tr
        th Responsable
        td= organizacion.responsable

    form.form-actions(action=`/vistas/organizaciones/${organizacion._id}/eliminar` method="POST")
      a.btn-secundario(href="/vistas/organizaciones") Cancelar
      button.btn-peligro(type="submit") Sí, dar de baja
