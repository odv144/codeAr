extends layout

block content
  fieldset
    legend Listado de Proyectos
    p
      a(href="/vistas") &larr; Volver al inicio
      if currentUser && currentUser.role === 'admin'
        | &nbsp;|&nbsp;
        a(href="/vistas/proyectos/nuevo") + Nuevo Proyecto
    
    if proyectos && proyectos.length > 0
      table
        thead
          tr
            th.num ID Proyecto
            th.num ID Organización
            th Nombre del Proyecto
            th Descripción
            th Acciones
        tbody
          each proyecto in proyectos
            tr
              td.num= proyecto.idProyecto
              td.num= proyecto.idOrganizacion
              td= proyecto.nomProyecto || "-"
              td= proyecto.descripcion || "-"
              td.acciones
                a(href=`/vistas/proyectos/${proyecto.idProyecto}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/proyectos/${proyecto.idProyecto}/editar`) Editar
                  a(href=`/vistas/proyectos/${proyecto.idProyecto}/eliminar`) Eliminar
    else
      p No hay proyectos registrados.
