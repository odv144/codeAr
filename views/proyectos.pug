extends layout

block content
  fieldset
    legend Listado de Proyectos
    if currentUser && currentUser.role === 'admin'
      p.acciones-detalle
        a.btn-primario(href="/vistas/proyectos/nuevo") + Nuevo Proyecto
    
    if proyectos && proyectos.length > 0
      table
        thead
          tr
            th ID Proyecto
            th ORGANIZACIÓN
            th Nombre del Proyecto
            th Descripción
            th.acciones Acciones
        tbody
          each proyecto in proyectos
            tr
              td= proyecto._id
              td= proyecto.nombreOrganizacion || proyecto.idOrganizacion
              td= proyecto.nomProyecto || "-"
              td= proyecto.descripcion || "-"
              td.acciones
                a(href=`/vistas/proyectos/${proyecto._id}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/proyectos/${proyecto._id}/editar`) Editar
                  a(href=`/vistas/proyectos/${proyecto._id}/eliminar`) Eliminar
    else
      p No hay proyectos registrados.
