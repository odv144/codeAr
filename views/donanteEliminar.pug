
extends layout

block content
  fieldset
    legend Eliminar Donante

    if !puedeEliminar
      p
        strong No se puede eliminar este donante.
      p
        | El donante tiene donaciones registradas.
        |  Para conservar su historial, no está permitida su eliminación.
    else
      p
        | ¿Confirma que desea eliminar el siguiente donante?
      p
        strong Esta acción eliminará permanentemente el registro y no podrá deshacerse.

    table.tabla-detalle
      tr
        th ID Donante
        td.num= donante._id

      tr
        th Nombre
        td= donante.nombre

      tr
        th Apellido
        td= donante.apellido

      tr
        th DNI
        td.num= donante.dni

      tr
        th Email
        td= donante.email

      tr
        th Total donado
        td.num= moneda(totalDonado)
      tr
        th Fecha de registro
        td
          if donante.createdAt
            = new Date(donante.createdAt).toLocaleDateString('es-AR', { timeZone: 'UTC' })
          else
            | No disponible

    if puedeEliminar
      form.form-actions(action=`/vistas/donantes/${donante._id}/eliminar` method="POST")
        a.btn-secundario(href="/vistas/donantes") Cancelar
        button.btn-peligro(type="submit") Sí, eliminar
    else
      p.acciones-detalle
        a.btn-secundario(href="/vistas/donantes") Volver al listado
        a.btn-primario(href=`/vistas/donantes/${donante._id}`) Ver detalle
