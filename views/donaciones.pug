extends layout

block content
  fieldset
    legend Registro de Donaciones
    p
      a(href="/vistas") &larr; Volver al inicio
      if currentUser && currentUser.role === 'admin'
        | &nbsp;|&nbsp;
        a(href="/vistas/donaciones/nuevo") + Nueva Donación
    
    if donaciones && donaciones.length > 0
      table
        thead
          tr
            th.num ID Donación
            th.num Monto
            th CBU
            th Fecha
            th.num ID Proyecto
            th.num ID Donante
            th.num ID Organización
            th Acciones
        tbody
          each donacion in donaciones
            tr
              td.num= donacion.idDonacion
              td.num $#{donacion.monto}
              td= donacion.cbu
              td= donacion.fecha
              td.num= donacion.idProyecto
              td.num= donacion.idDonante
              td.num= donacion.idOrganizacion
              td.acciones
                a(href=`/vistas/donaciones/${donacion.idDonacion}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/donaciones/${donacion.idDonacion}/editar`) Editar
                  a(href=`/vistas/donaciones/${donacion.idDonacion}/eliminar`) Eliminar
    else
      p No hay donaciones registradas.
