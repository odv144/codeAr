extends layout

block content
  fieldset
    legend Registro de Donaciones
    if currentUser && currentUser.role === 'admin'
      p.acciones-detalle
        a.btn-primario(href="/vistas/donaciones/nuevo") + Nueva Donación
    
    if donaciones && donaciones.length > 0
      table
        thead
          tr
              th Monto
              th CBU
              th Fecha
              th Proyecto
              th Donante
              th Organización
              th.acciones Acciones
        tbody
          each donacion in donaciones
            tr
              td $#{donacion.monto}
              td= donacion.cbu
              td.nowrap= donacion.fecha.toISOString().slice(0, 10)
              td= donacion.nombreProyecto || donacion.idProyecto
              td= donacion.nombreDonante || donacion.idDonante
              td= donacion.nombreOrganizacion || donacion.idOrganizacion
              td.acciones
                a(href=`/vistas/donaciones/${donacion._id}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/donaciones/${donacion._id}/editar`) Editar
                  a(href=`/vistas/donaciones/${donacion._id}/eliminar`) Eliminar
    else
      p No hay donaciones registradas.
