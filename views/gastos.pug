extends layout

block content
  div(class="flex justify-between items-center mb-6")
    h2(class="text-2xl font-bold text-slate-900") Control de Gastos
    a(href="/vistas" class="text-sm font-medium text-emerald-600 hover:text-emerald-700") &larr; Volver al inicio

  if gastos && gastos.length > 0
    div(class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden")
      div(class="overflow-x-auto")
        table(class="w-full text-left border-collapse")
          thead(class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider")
            tr
              th(class="px-6 py-3") ID Gasto
              th(class="px-6 py-3") Proyecto ID
              th(class="px-6 py-3") Descripción
              th(class="px-6 py-3") Monto
              th(class="px-6 py-3") Fecha
          tbody(class="divide-y divide-slate-200 text-sm text-slate-700")
            each gasto in gastos
              tr(class="hover:bg-slate-50 transition")
                td(class="px-6 py-4 font-medium text-slate-900") ##{gasto.idGasto}
                td(class="px-6 py-4") ##{gasto.idProyecto}
                td(class="px-6 py-4")= gasto.descripcion
                td(class="px-6 py-4 font-semibold text-emerald-600") $#{gasto.monto}
                td(class="px-6 py-4 text-slate-500")= gasto.fecha
  else
    div(class="bg-white p-8 rounded-xl border border-slate-200 text-center text-slate-500")
      p No hay gastos registrados.
