extends layout

block content
  fieldset
    legend Control de Gastos
    p
      a(href="/vistas") &larr; Volver al inicio
      if currentUser && currentUser.role === 'admin'
        | &nbsp;|&nbsp;
        a(href="/vistas/gastos/nuevo") + Nuevo Gasto
    
    if gastos && gastos.length > 0
      table
        thead
          tr
            th.num ID Gasto
            th.num Proyecto ID
            th Descripción
            th.num Monto
            th Fecha
            th Acciones
        tbody
          each gasto in gastos
            tr
              td.num= gasto.idGasto
              td.num= gasto.idProyecto
              td= gasto.descripcion
              td.num $#{gasto.monto}
              td= gasto.fecha.toISOString().slice(0, 10)
              td.acciones
                a(href=`/vistas/gastos/${gasto.idGasto}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/gastos/${gasto.idGasto}/editar`) Editar
                  a(href=`/vistas/gastos/${gasto.idGasto}/eliminar`) Eliminar
    else
      p No hay gastos registrados.