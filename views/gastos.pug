extends layout

block content
  fieldset
    legend Control de Gastos
    p
      a(href="/vistas") &larr; Volver al inicio
    
    if gastos && gastos.length > 0
      table(border="1" cellpadding="5" cellspacing="0")
        thead
          tr
            th ID Gasto
            th Proyecto ID
            th Descripción
            th Monto
            th Fecha
        tbody
          each gasto in gastos
            tr
              td= gasto.idGasto
              td= gasto.idProyecto
              td= gasto.descripcion
              td $#{gasto.monto}
              td= gasto.fecha
    else
      p No hay gastos registrados.
