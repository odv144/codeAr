extends layout

block content
  fieldset
    legend Detalle de la Organización

    if organizacion
      - const dadaDeBaja = organizacion.activa === false
      table.tabla-detalle
        tr
          th Nombre
          td= organizacion.nombre
        tr
          th Tipo
          td= organizacion.tipo
        tr
          th CUIL
          td.num= organizacion.cuil
        tr
          th Teléfono
          td.num= organizacion.telefono
        tr
          th Email
          td= organizacion.mail
        tr
          th Dirección
          td= organizacion.direccion
        tr
          th Responsable
          td= organizacion.responsable
        if dadaDeBaja
          tr
            th Estado
            td
              span.estado-baja Dada de baja
              if organizacion.fechaBaja
                |  el #{new Date(organizacion.fechaBaja).toLocaleDateString('es-AR')}

      p.acciones-detalle
        if currentUser && currentUser.role === 'admin'
          if dadaDeBaja
            a.btn-primario(href=`/vistas/organizaciones/${organizacion._id}/reactivar`) Reactivar
          else
            a.btn-secundario(href=`/vistas/organizaciones/${organizacion._id}/editar`) Editar
            a.btn-peligro(href=`/vistas/organizaciones/${organizacion._id}/eliminar`) Dar de baja
        a.btn-secundario(href="/vistas/organizaciones") Volver al listado
    else
      p Organización no encontrada.
