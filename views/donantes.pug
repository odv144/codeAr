extends layout

block content
  fieldset
    legend Listado de Donantes
    p
      a(href="/vistas") &larr; Volver al inicio
      if currentUser && currentUser.role === 'admin'
        | &nbsp;|&nbsp;
        a(href="/vistas/donantes/nuevo") + Nuevo Donante
    
    if donantes && donantes.length > 0
      table
        thead
          tr
            th.num ID
            th Nombre
            th Apellido
            th.num DNI
            th.num Teléfono
            th Email
            th.num Monto
            th Fecha
            th Acciones
        tbody
          each donante in donantes
            tr
              td.num= donante.idDonante
              td= donante.nombre
              td= donante.apellido
              td.num= donante.dni
              td.num= donante.telefono
              td= donante.email
              td.num $#{donante.monto}
              td= donante.fecha
              td.acciones
                a(href=`/vistas/donantes/${donante.idDonante}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/donantes/${donante.idDonante}/editar`) Editar
                  a(href=`/vistas/donantes/${donante.idDonante}/eliminar`) Eliminar
    else
      p No hay donantes registrados.
