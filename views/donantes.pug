extends layout

block content
  fieldset
    legend Listado de Donantes
    if currentUser && currentUser.role === 'admin'
      p.acciones-detalle
        a.btn-primario(href="/vistas/donantes/nuevo") + Nuevo Donante
    
    if donantes && donantes.length > 0
      table
        thead
          tr
            th ID
            th Nombre
            th Apellido
            th.num DNI
            th.num Teléfono
            th Email
            th.num Monto
            th Fecha
            th.acciones Acciones
        tbody
          each donante in donantes
            tr
              td= donante._id
              td= donante.nombre
              td= donante.apellido
              td.num= donante.dni
              td.num= donante.telefono
              td= donante.email
              td.num $#{donante.monto}
              td= donante.fecha.toISOString().slice(0, 10)
              td.acciones
                a(href=`/vistas/donantes/${donante._id}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/donantes/${donante._id}/editar`) Editar
                  a(href=`/vistas/donantes/${donante._id}/eliminar`) Eliminar
    else
      p No hay donantes registrados.
