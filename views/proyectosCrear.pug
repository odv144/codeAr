extends layout

block content
  fieldset
    legend Registrar Nuevo Proyecto
    p
      a(href="/vistas/proyectos") &larr; Volver al listado de proyectos

    form(action="/vistas/proyectos" method="POST")
      div
        label(for="idOrganizacion") ID de Organización
        input(type="number" name="idOrganizacion" id="idOrganizacion" required)

      div
        label(for="nomProyecto") Nombre del Proyecto
        input(type="text" name="nomProyecto" id="nomProyecto" required)

      div
        label(for="descripcion") Descripción
        textarea(name="descripcion" id="descripcion" rows="4" required)

      div
        label(for="saldo") Saldo Inicial ($)
        input(type="number" step="0.01" name="saldo" id="saldo" required)

      .form-actions
        button.btn-secundario(type="reset") Limpiar
        button(type="submit") Guardar Proyecto
