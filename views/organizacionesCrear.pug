extends layout

block content
  fieldset
    legend Registrar Nueva Organización
    p
      a(href="/vistas/organizaciones") &larr; Volver al listado de organizaciones

    form(action="/vistas/organizaciones" method="POST")
      div
        label(for="nombre") Nombre de la Organización
        input(type="text" name="nombre" id="nombre" required)

      div
        label(for="tipo") Tipo (Ej. Fundación, Asociación Civil, ONG)
        input(type="text" name="tipo" id="tipo" required)

      div
        label(for="cuil") CUIL (Ej. 30-71234567-8)
        input(type="text" name="cuil" id="cuil" required)

      div
        label(for="telefono") Teléfono
        input(type="text" name="telefono" id="telefono" required)

      div
        label(for="mail") Correo Electrónico
        input(type="email" name="mail" id="mail" required)

      div
        label(for="direccion") Dirección
        input(type="text" name="direccion" id="direccion" required)

      div
        label(for="responsable") Responsable a Cargo
        input(type="text" name="responsable" id="responsable" required)

      .form-actions
        button.btn-secundario(type="reset") Limpiar
        button(type="submit") Guardar Organización
