extends layout

block content
  fieldset
    legend Eliminar Proyecto
    p
      a(href="/vistas/proyectos") &larr; Volver al listado
      | &nbsp;|&nbsp;
      a(href=`/vistas/proyectos/${proyecto.idProyecto}`) Ver detalle

    p
      | ¿Confirma que desea eliminar el siguiente proyecto?
      strong  Esta acción eliminará permanentemente el proyecto y no podrá deshacerse
      |  (borrado físico del registro).

    table
      tr
        th.num ID Proyecto
        td.num= proyecto.idProyecto
      tr
        th.num ID Organización
        td.num= proyecto.idOrganizacion
      tr
        th Nombre
        td= proyecto.nomProyecto
      tr
        th Descripción
        td= proyecto.descripcion || "-"

    form.form-actions(action=`/vistas/proyectos/${proyecto.idProyecto}/eliminar` method="POST")
      a.btn-secundario(href="/vistas/proyectos") Cancelar
      button.btn-peligro(type="submit") Sí, eliminar
