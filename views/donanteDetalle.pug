
extends layout

block content
  article.formulario-card
    h3 Detalle del Donante

    table.tabla-detalle
      tr
        th Nombre
        td= donante.nombre
      tr
        th Apellido
        td= donante.apellido
      tr
        th DNI
        td.num= donante.dni
      tr
        th Teléfono
        td.num= donante.telefono
      tr
        th Email
        td= donante.email

      tr
        th Total donado
        td.num= moneda(totalDonado)

      tr
        th Cantidad de aportes
        td.num= cantidadDonaciones

      tr
        th Fecha de registro
        td
          if donante.createdAt
            = new Date(donante.createdAt).toLocaleDateString('es-AR', { timeZone: 'UTC' })
          else
            | No disponible

    
    p.acciones-detalle
      if currentUser && currentUser.role === 'admin'
        a.btn-primario(href=`/vistas/donaciones/nuevo?donante=${donante._id}`) + Nueva donación
        a.btn-secundario(href=`/vistas/donantes/${donante._id}/editar`) Editar
        a.btn-peligro(href=`/vistas/donantes/${donante._id}/eliminar`) Eliminar

      a.btn-secundario(href="/vistas/donantes") Volver al listado
