doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= titulo || "SumarImpacto | Trazabilidad End-to-End"
    style.
      body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; color: #333; background-color: #fafafa; }
      header, footer { background: #ffffff; padding: 15px; border: 1px solid #ccc; margin-bottom: 20px; border-radius: 4px; }
      nav ul { list-style: none; padding: 0; display: flex; gap: 15px; margin: 10px 0 0 0; }
      nav a { text-decoration: none; color: #0056b3; font-weight: bold; }
      nav a:hover { text-decoration: underline; }
      table { width: 100%; border-collapse: collapse; margin-top: 15px; background: #fff; }
      th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
      th { background: #eaeaea; }
      fieldset { border: 1px solid #ccc; padding: 20px; margin-bottom: 15px; border-radius: 5px; background: #fff; }
      legend { font-weight: bold; padding: 0 8px; background: #fff; border: 1px solid #ccc; border-radius: 3px; }
      button, select { padding: 8px 12px; margin: 5px 0; border: 1px solid #ccc; border-radius: 4px; background: #f9f9f9; cursor: pointer; }
      button:hover { background: #e0e0e0; }
  body
    header
      h2 SumarImpacto - Plataforma B2NGO
      p Sistema de Trazabilidad End-to-End y Control Operativo
      nav
        ul
          li
            a(href="/vistas") Inicio
          li
            a(href="/vistas/proyectos") Proyectos
          li
            a(href="/vistas/organizaciones") Organizaciones
          li
            a(href="/vistas/gastos") Gastos
          li
            a(href="/vistas/donaciones") Donaciones

    main
      block content

    footer
      p SumarImpacto &copy; 2026. Desarrollado por CodeAr para SumarImpacto.
