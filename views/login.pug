extends layout

block content
  article.tarjeta-login
    header.login-header
      h2 SumarImpacto
      p.subtitulo-login Plataforma de trazabilidad y control operativo para ONGs.
      p.instruccion-login Ingresá tus credenciales para acceder al sistema.

    h3 Iniciar sesión

    form#login-form
      label(for="email") Email o usuario
      input#email(type="text" name="email" autocomplete="username" required placeholder="admin o admin@sumarimpacto.com")

      label(for="password") Contraseña
      .password-wrapper
        input#password(type="password" name="password" autocomplete="current-password" required)
        button#togglePassword.toggle-password(type="button" aria-label="Mostrar contraseña")
          svg#eyeIcon(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            path(d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z")
            circle(cx="12" cy="12" r="3")

      div(role="group" style="margin-top: 1rem;")
        button(type="submit") Ingresar

      p(style="margin-top: 1rem; text-align: center; font-size: 0.9rem;")
        | ¿No tenés cuenta? 
        a(href="/registro") Registrate acá

      div#error-box(role="alert" aria-live="assertive" hidden)

    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script.
      const form = document.getElementById('login-form');
      const errorBox = document.getElementById('error-box');
      const togglePassword = document.getElementById('togglePassword');
      const passwordInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eyeIcon');

      if (togglePassword && passwordInput) {
        togglePassword.addEventListener('click', () => {
          const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
          passwordInput.setAttribute('type', type);

          if (type === 'text') {
            eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
          } else {
            eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
          }
        });
      }

      // Detectar si vino por ?registrado=true o si hay éxito
      const params = new URLSearchParams(window.location.search);
      const serverSuccess = "#{successMessage || ''}";

      if (params.get('registrado') === 'true' || serverSuccess) {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: 'success',
          title: '¡Usuario registrado!',
          text: 'Iniciá sesión con tus credenciales',
          showConfirmButton: false,
          timer: 4000,
          timerProgressBar: true
        });
        window.history.replaceState({}, document.title, window.location.pathname);
      }

      const mostrarError = (mensaje) => {
        errorBox.textContent = mensaje;
        errorBox.hidden = false;
      };

      const limpiarError = () => {
        errorBox.textContent = '';
        errorBox.hidden = true;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        limpiarError();

        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;

        try {
          const res = await fetch('/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json().catch(() => ({}));

          if (res.status === 200) {
            window.location.href = data.redirectUrl || '/vistas';
            return;
          }

          mostrarError(data.error || 'No se pudo iniciar sesión. Intente nuevamente.');
        } catch (error) {
          mostrarError('No se pudo conectar con el servidor.');
        }
      });
