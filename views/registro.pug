extends layout

block content
  article.tarjeta-login
    header.login-header
      h2 SumarImpacto
      p.subtitulo-login Plataforma de trazabilidad y control operativo para ONGs.
      p.instruccion-login Registrate para crear una cuenta de operador.

    h3 Crear cuenta
    form#registro-form
      label(for="userName") Nombre de usuario
      input#userName(type="text" name="userName" autocomplete="username" required placeholder="usuario123")

      label(for="email") Correo electrónico
      input#email(type="email" name="email" autocomplete="email" required placeholder="correo@ejemplo.com")

      label(for="firstName") Nombre
      input#firstName(type="text" name="firstName" autocomplete="given-name" required placeholder="Juan")

      label(for="lastName") Apellido
      input#lastName(type="text" name="lastName" autocomplete="family-name" required placeholder="Pérez")

      label(for="password") Contraseña
      .password-wrapper
        input#password(type="password" name="password" autocomplete="new-password" required minlength="6")
        button#togglePassword.toggle-password(type="button" aria-label="Mostrar contraseña")
          svg#eyeIcon(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            path(d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z")
            circle(cx="12" cy="12" r="3")

      div(role="group" style="margin-top: 1rem;")
        button(type="submit") Registrarse

      p(style="margin-top: 1rem; text-align: center; font-size: 0.9rem;")
        | ¿Ya tenés cuenta? 
        a(href="/login") Ingresá acá

      div#error-box(role="alert" aria-live="assertive" hidden)

    script.
      const form = document.getElementById('registro-form');
      const errorBox = document.getElementById('error-box');
      const togglePassword = document.getElementById('togglePassword');
      const passwordInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eyeIcon');

      if (togglePassword && passwordInput) {
        togglePassword.addEventListener('click', () => {
          const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
          passwordInput.setAttribute('type', type);

          if (type === 'text') {
            eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
          } else {
            eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
          }
        });
      }

      const mostrarError = (mensaje) => {
        errorBox.textContent = mensaje;
        errorBox.hidden = false;
      };

      const limpiarError = () => {
        errorBox.textContent = '';
        errorBox.hidden = true;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        limpiarError();

        const userName = document.getElementById('userName').value.trim();
        const email = document.getElementById('email').value.trim();
        const firstName = document.getElementById('firstName').value.trim();
        const lastName = document.getElementById('lastName').value.trim();
        const password = document.getElementById('password').value;

        try {
          const res = await fetch('/registro', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userName, email, firstName, lastName, password })
          });

          const data = await res.json().catch(() => ({}));

          if (res.status === 201 || res.status === 200) {
            window.location.href = data.redirectUrl || '/vistas';
            return;
          }

          mostrarError(data.error || 'No se pudo completar el registro. Intente nuevamente.');
        } catch (error) {
          mostrarError('No se pudo conectar con el servidor.');
        }
      });
