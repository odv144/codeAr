extends layout

block content
  article.formulario-card
    h3 Detalle del Gasto

    table
      tr
        th.num ID Gasto
        td.num= gasto.idGasto
      tr
        th.num ID Proyecto
        td.num= gasto.idProyecto
      tr
        th Descripción
        td= gasto.descripcion
      tr
        th.num Monto
        td.num $ #{gasto.monto}
      tr
        th Fecha
        td= gasto.fecha.toISOString().slice(0, 10)

    p.acciones-detalle
      a.btn-secundario(href="/vistas/gastos") Volver al listado
      if currentUser && currentUser.role === 'admin'
        a.btn-secundario(href=`/vistas/gastos/${gasto.idGasto}/editar`) Editar
