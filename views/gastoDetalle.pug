extends layout

block content
  article.formulario-card
    h3 Detalle del Gasto

    table.tabla-detalle
      tr
        th Proyecto
        td= proyecto ? (proyecto.nombre || proyecto.nomProyecto) : "-"
      tr
        th Descripción
        td= gasto.descripcion
      tr
        th Monto
        td.num $ #{gasto.monto}
      tr
        th Fecha
        td= gasto.fecha.toISOString().slice(0, 10)

    p.acciones-detalle
      if currentUser && currentUser.role === 'admin'
        a.btn-secundario(href=`/vistas/gastos/${gasto._id}/editar`) Editar
        a.btn-peligro(href=`/vistas/gastos/${gasto._id}/eliminar`) Eliminar
      a.btn-secundario(href="/vistas/gastos") Volver al listado
