extends layout

block content
  article.formulario-card
    h3 Registrar Nuevo Gasto

    form(action="/vistas/gastos" method="POST")
      div
        label(for="idProyecto") Proyecto
        select(name="idProyecto" id="idProyecto" required)
          option(value="") Seleccioná un proyecto...
          each proyecto in proyectos
            option(value=proyecto._id)= proyecto.nomProyecto

      div
        label(for="descripcion") Descripción
        textarea(name="descripcion" id="descripcion" rows="4" required)

      div
        label(for="monto") Monto ($)
        input(type="number" step="0.01" name="monto" id="monto" required)

      div
        label(for="fecha") Fecha (YYYY-MM-DD)
        input(type="date" name="fecha" id="fecha" required)

      .form-actions
        button.btn-secundario(type="reset") Limpiar
        a.btn-secundario(href="/vistas/gastos") Cancelar
        button(type="submit") Guardar Gasto
