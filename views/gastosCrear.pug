extends layout

block content
  fieldset
    legend Registrar Nuevo Gasto
    p
      a(href="/vistas/gastos") &larr; Volver al listado de gastos
    
    form(action="/vistas/gastos" method="POST" style="margin-top: 15px;")
      div(style="margin-bottom: 10px;")
        label(for="idProyecto") ID Proyecto:
        br
        input(type="number" name="idProyecto" id="idProyecto" required style="width: 100%; max-width: 300px; padding: 5px;")
      
      div(style="margin-bottom: 10px;")
        label(for="descripcion") Descripción:
        br
        textarea(name="descripcion" id="descripcion" rows="4" required style="width: 100%; max-width: 400px; padding: 5px;")
      
      div(style="margin-bottom: 10px;")
        label(for="monto") Monto ($):
        br
        input(type="number" step="0.01" name="monto" id="monto" required style="width: 100%; max-width: 300px; padding: 5px;")
      
      div(style="margin-bottom: 15px;")
        label(for="fecha") Fecha (YYYY-MM-DD):
        br
        input(type="date" name="fecha" id="fecha" required style="width: 100%; max-width: 300px; padding: 5px;")
      
      div
        button(type="submit") Guardar Gasto
        | &nbsp;
        button(type="reset") Limpiar
