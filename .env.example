# Puerto del servidor HTTP
PORT=3000

# Base de datos MongoDB (nombre de la base dentro del cluster)
DBNAME=sumarImpacto

# Cadena de conexión a MongoDB Atlas (reemplazar con credenciales propias)
MONGO_URI=mongodb://USUARIO:CLAVE@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=REPLICA_SET&authSource=admin&appName=MI_APP

# Sesiones (usar un valor largo y aleatorio en cada entorno; nunca el mismo en prod y dev)
SESSION_SECRET=reemplazar-con-valor-largo-y-aleatorio
SESSION_TTL_MINUTES=480

# Credenciales de desarrollo: las crea/sincroniza scripts/seedUsers.js al arrancar el servidor.
# NO usar estas contraseñas en producción.
ADMIN_USER=admin
ADMIN_EMAIL=admin@sumarimpacto.com
ADMIN_PASSWORD=Admin1234!
OPERADOR_USER=operador
OPERADOR_EMAIL=usuario@sumarimpacto.com
OPERADOR_PASSWORD=Usuario1234!
